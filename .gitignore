# Build outputs
build/
dist/
*.o
*.obj
*.bin.tmp

# Python virtual environment (created by tools/bootstrap.ps1)
.venv/
__pycache__/
*.pyc

# PlatformIO / pioarduino
sdkconfig.old
managed_components/
dependencies.lock
.pio/

# CrossPoint upstream working tree (re-clonable ~60MB; NOT vendored here).
# Reconstruct it with tools/setup-crosspoint.sh (clones + applies our overlay).
# Our authored override is tracked at firmware-x4/platformio.local.ini.
firmware-x4/crosspoint/

# Device flash backups (large, device-specific, potentially sensitive)
# Keep the folder + docs, ignore the raw dumps.
backups/*.bin
backups/*.img
backups/*.hex

# Node / iOS tooling
node_modules/
ios/**/Pods/
ios/**/*.xcuserstate
DerivedData/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/*.log
firmware-x4/src/device_protocol/barectf*.c
firmware-x4/src/device_protocol/barectf*.h
firmware-x4/src/device_protocol/MuseTrace.*
.venv-tracing/
