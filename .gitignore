# Build outputs
build/
dist/
*.o
*.obj
*.bin.tmp

# Python virtual environment (created by tools/bootstrap.ps1)
.venv/
__pycache__/
*.pyc

# PlatformIO / pioarduino
sdkconfig.old
managed_components/
dependencies.lock

# Device flash backups (large, device-specific, potentially sensitive)
# Keep the folder + docs, ignore the raw dumps.
backups/*.bin
backups/*.img
backups/*.hex

# Node / iOS tooling
node_modules/
ios/**/Pods/
ios/**/*.xcuserstate
DerivedData/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/*.log
