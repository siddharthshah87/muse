+// Margin/Muse: the words of one laid-out page, space-joined (the companion's narration text).
+static bool museLoadPageText(Section& section, int pageIndex, std::string& out) {
+  out.clear();
+  auto page = section.loadPage(pageIndex);
+  if (!page) return false;
+  out.reserve(512);
+  for (const auto& el : page->elements) {
+    if (el->getTag() != TAG_PageLine) continue;
+    const auto& block = static_cast<const PageLine&>(*el).getBlock();
+    if (!block || block->isEmpty()) continue;
+    for (uint16_t i = 0; i < block->wordCount(); i++) {
+      if (!out.empty()) out += ' ';
+      out += block->wordText(i);
+    }
+  }
+  return true;
+}
+
+// Margin/Muse: appends s escaped as a JSON string body, at most maxBytes, cut at a UTF-8 boundary.
+static void museAppendJson(std::string& out, const std::string& s, size_t maxBytes) {
+  size_t n = std::min(s.size(), maxBytes);
+  while (n > 0 && n < s.size() && (static_cast<uint8_t>(s[n]) & 0xC0) == 0x80) --n;
+  for (size_t i = 0; i < n; ++i) {
+    const char c = s[i];
+    if (c == '"' || c == '\\') {
+      out += '\\';
+      out += c;
+    } else {
+      out += static_cast<uint8_t>(c) < 0x20 ? ' ' : c;
+    }
+  }
+}
+
+// Margin/Muse: book/chapter info for the page about to be sent (shared/protocol/ble.md). The book
+// id is an FNV-1a hash of the file path: stable per book, without sending the path itself.
+static uint32_t museBookId(const Epub& epub) {
+  uint32_t id = 2166136261u;
+  for (const char c : epub.getPath()) {
+    id ^= static_cast<uint8_t>(c);
+    id *= 16777619u;
+  }
+  return id;
+}
+
+// Margin/Muse: companion notes for a book (e.g. character voices) live next to the book's cache.
+static char museNotes[513];  // static: keeps it off the small task stack
+static uint32_t museNotesBook = 0;
+
+static void musePublishBookNotes(const Epub& epub, uint32_t id) {
+  if (id == museNotesBook) return;
+  museNotesBook = id;
+  const std::string path = epub.getCachePath() + "/margin.json";
+  size_t n = Storage.exists(path.c_str()) ? Storage.readFileToBuffer(path.c_str(), museNotes, sizeof(museNotes) - 1) : 0;
+  museNotes[n] = '\0';
+  MuseBleServer::setBookNotes(museNotes, n);
+}
+
+static void museSaveBookNotes(const Epub& epub) {
+  const size_t n = MuseBleServer::takeBookNotes(museNotes, sizeof(museNotes));
+  if (n == 0) return;
+  char expect[24];
+  snprintf(expect, sizeof(expect), "\"b\":\"%08lx\"", static_cast<unsigned long>(museBookId(epub)));
+  if (!strstr(museNotes, expect)) {  // written for another book (e.g. one just closed): ignore
+    LOG_DBG("MUSE", "Notes for another book ignored");
+    return;
+  }
+  const std::string path = epub.getCachePath() + "/margin.json";
+  if (!Storage.writeFile(path.c_str(), String(museNotes))) LOG_ERR("MUSE", "Could not save %s", path.c_str());
+  MuseBleServer::setBookNotes(museNotes, n);
+}
+
+static void museSendBookInfo(const Epub& epub, const Section* section, int spineIndex, int page) {
+  const uint32_t id = museBookId(epub);
+  musePublishBookNotes(epub, id);
+  const bool lastInChapter = section && !section->isBuilding() && !section->isPartial() &&
+                             page + 1 >= static_cast<int>(section->pageCount);
+  char head[96];
+  snprintf(head, sizeof(head), "{\"b\":\"%08lx\",\"ch\":%d,\"chs\":%d,\"pg\":%d,\"last\":%d,\"t\":\"",
+           static_cast<unsigned long>(id), spineIndex, epub.getSpineItemsCount(), page, lastInChapter ? 1 : 0);
+  std::string json;
+  json.reserve(240);
+  json += head;
+  museAppendJson(json, epub.getTitle(), 80);
+  json += "\",\"a\":\"";
+  museAppendJson(json, epub.getAuthor(), 50);
+  json += "\"}";
+  MuseBleServer::notifyBookInfo(json.c_str(), json.size());
+}
+
+// Margin/Muse: follow-along underline (BLE HIGHLIGHT 0x04). Drawn straight into the framebuffer and
+// shown with a FAST refresh (no full page re-render, so the full-refresh counter is untouched).
+// The pixels under each underline are saved first, so moving the highlight restores them exactly
+// (painting white would clip descenders).
+static int museRenderLeft = 0, museRenderTop = 0;  // margins of the page last rendered
+static int museHlSpine = -1, museHlPage = -1;       // page the saved strips belong to
+struct MuseHlStrip {
+  int16_t x, y, w;
+  uint8_t bytes[600];
+};
+static constexpr int MUSE_HL_MAX_LINES = 12;
+static MuseHlStrip museHlStrips[MUSE_HL_MAX_LINES];  // static: ~7 KB kept off the task stack
+static int museHlCount = 0;
+
+static void museHlRestore(GfxRenderer& renderer, int spine, int page) {
+  if (spine == museHlSpine && page == museHlPage) {
+    for (int i = museHlCount - 1; i >= 0; --i) {
+      const MuseHlStrip& st = museHlStrips[i];
+      renderer.writeFramebufferRegion(st.x, st.y, st.w, 2, st.bytes);
+    }
+  }
+  museHlCount = 0;  // a different page was rendered since: its framebuffer has no underlines
+  museHlSpine = spine;
+  museHlPage = page;
+}
+
+static void museHlDraw(GfxRenderer& renderer, const Page& page, int first, int last) {
+  const int fontId = SETTINGS.getReaderFontId();
+  const int ascender = renderer.getFontAscenderSize(fontId);
+  int k = 0;  // word index in museLoadPageText order
+  for (const auto& el : page.elements) {
+    if (el->getTag() != TAG_PageLine) continue;
+    const auto& line = static_cast<const PageLine&>(*el);
+    const auto& block = line.getBlock();
+    if (!block || block->isEmpty()) continue;
+    int x0 = INT_MAX, x1 = INT_MIN;
+    for (uint16_t i = 0; i < block->wordCount(); ++i, ++k) {
+      if (k < first || k > last) continue;
+      const char* text = block->wordText(i);
+      int x = line.xPos + block->wordXpos(i) + museRenderLeft;
+      if (strncmp(text, "\xE2\x80\x83", 3) == 0) {  // paragraph-indent em space: not underlined
+        x += renderer.getTextAdvanceX(fontId, "\xE2\x80\x83", block->wordStyle(i));
+        text += 3;
+      }
+      x0 = std::min(x0, x);
+      x1 = std::max(x1, x + renderer.getTextAdvanceX(fontId, text, block->wordStyle(i)));
+    }
+    if (x0 < x1 && museHlCount < MUSE_HL_MAX_LINES) {
+      MuseHlStrip& st = museHlStrips[museHlCount];
+      st.x = static_cast<int16_t>(x0);
+      st.y = static_cast<int16_t>(line.yPos + museRenderTop + block->getRubyShift(ascender) + ascender + 2);
+      st.w = static_cast<int16_t>(x1 - x0);
+      if (renderer.readFramebufferRegion(st.x, st.y, st.w, 2, st.bytes, sizeof(st.bytes))) {
+        museHlCount++;
+        renderer.fillRect(st.x, st.y, st.w, 2, true);
+      }
+    }
+    if (k > last) break;
+  }
+}
