+// Margin/Muse: expose current reading position for narration sync.
+void CrossPointWebServer::handleReading() const {
+  const auto snap = ReadingState::get();
+  JsonDocument doc;
+  doc["active"] = snap.active;
+  if (snap.active) {
+    doc["book"]        = snap.bookPath;
+    doc["title"]       = snap.title;
+    doc["author"]      = snap.author;
+    doc["spine_index"] = snap.spineIndex;
+    doc["char_offset"] = snap.charOffset;
+    doc["progress"]    = snap.progress;
+    doc["updated_ms"]  = snap.updatedMs;
+  }
+  String response;
+  serializeJson(doc, response);
+  server->send(200, "application/json", response);
+}
