{
  "name": "margin-companion",
  "version": "1.0.0",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "build:dev": "eas build --profile development --platform ios"
  },
  "dependencies": {
    "@kesha-antonov/react-native-background-downloader": "^4.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.32",
    "expo-build-properties": "~55.0.18",
    "expo-dev-client": "~55.0.41",
    "expo-speech": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-audio-api": "^0.13.6",
    "react-native-ble-plx": "^3.5.1",
    "react-native-blob-util": "^0.25.1",
    "react-native-executorch": "^0.11.0",
    "react-native-worklets": "0.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.2.10",
    "typescript": "~5.9.2"
  },
  "react-native-executorch": {
    "features": [
      "textToSpeech"
    ],
    "backends": [
      "xnnpack"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    }
  },
  "overrides": {
    "react-native-worklets": "0.12.2"
  }
}
