{
  "expo": {
    "name": "Margin",
    "slug": "margin-reader",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "margin",
    "platforms": [
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "com.siddharthshah87.margin",
      "supportsTablet": false,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Margin uses Bluetooth to connect to your e-reader and receive page text for narration.",
        "NSBluetoothPeripheralUsageDescription": "Margin uses Bluetooth to connect to your e-reader and receive page text for narration.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "audio",
          "fetch"
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "6e439c5c-59fe-4470-99aa-12cc23953e8d"
      }
    },
    "owner": "siddharthshah87",
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "disableFFmpeg": true
        }
      ]
    ]
  }
}
